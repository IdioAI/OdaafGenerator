<UserControl x:Class="OdaafGenerator.App.DocumentHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:OdaafGenerator.Core;assembly=OdaafGenerator.Core"
             xmlns:local="clr-namespace:OdaafGenerator.App">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>
  <Grid>
    <ScrollViewer Visibility="{Binding IsProjectIndex, Converter={StaticResource BoolVis}}">
      <StackPanel Margin="16" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ProjectIndex.Name}"/>
        <TextBlock Margin="0,6,0,12" Foreground="#667085" TextWrapping="Wrap">
          <Run Text="id "/><Run Text="{Binding ProjectIndex.Id, Mode=OneWay}"/>
          <Run Text="  默认上下文 "/><Run Text="{Binding ProjectIndex.DefaultContextId, Mode=OneWay}"/>
          <Run Text="  本体 "/><Run Text="{Binding ProjectIndex.OdaafUri, Mode=OneWay}"/>
          <Run Text="  "/><Run Text="{Binding ProjectIndex.GraphVersion, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
          <Run Text="项目 "/><Run Text="{Binding ProjectIndex.ProjectCount, Mode=OneWay}"/>
          <Run Text="  焦点声明 "/><Run Text="{Binding ProjectIndex.DeclarationCount, Mode=OneWay}"/>
          <Run Text="  焦点工程："/>
          <Run Text="{Binding ProjectIndex.FocusProjects[0], Mode=OneWay}"/>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding ProjectIndex.FocusProjects}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#667085"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="输入与输出"/>
        <ItemsControl ItemsSource="{Binding ProjectIndex.Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type core:ProjectFileRow}">
              <Border Margin="0,0,0,8" Padding="10" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6" Background="White">
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="#667085" Text="{Binding Kind}"/>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Role}"/>
                  </DockPanel>
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Path}"/>
                  <TextBlock Margin="0,2,0,0" Foreground="#667085">
                    <Run Text="{Binding Exists, Mode=OneWay, StringFormat=存在:{0}}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding Bytes, Mode=OneWay, StringFormat=字节:{0}}"/>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Grid Visibility="{Binding IsIndexBrowse, Converter={StaticResource BoolVis}}">
      <Grid>
        <Grid.DataContext>
          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
        </Grid.DataContext>
        <Grid.RowDefinitions>
          <RowDefinition Height="160"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6" Margin="8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4">
            <Button DockPanel.Dock="Right" Content="查找" Width="64" Margin="8,0,0,0" Click="Search_Click"/>
            <TextBox DockPanel.Dock="Right" Width="180" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"/>
            <ComboBox DockPanel.Dock="Right" Width="96"
                      ItemsSource="{Binding Levels}" SelectedItem="{Binding ChosenLevel}"/>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="查找结果"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding Hits}" BorderThickness="0" SelectionChanged="Hits_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type core:SearchHit}">
                <StackPanel Margin="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Subtitle}" Foreground="#667085" FontSize="11"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6" Margin="8,0,8,8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4" FontWeight="SemiBold" Text="目录（焦点项目可展开，辅助工程只到项目名）"/>
          <TreeView BorderThickness="0" ItemsSource="{Binding Projects}"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type core:ProjectEntry}" ItemsSource="{Binding Namespaces}">
                <TextBlock Text="{Binding Name}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#667085"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocus}" Value="True">
                          <Setter Property="Foreground" Value="#1D4E89"/>
                          <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </HierarchicalDataTemplate>
              <HierarchicalDataTemplate DataType="{x:Type core:NamespaceEntry}" ItemsSource="{Binding Types}">
                <TextBlock Text="{Binding Name}"/>
              </HierarchicalDataTemplate>
              <HierarchicalDataTemplate DataType="{x:Type core:TypeEntry}" ItemsSource="{Binding Functions}">
                <TextBlock Text="{Binding Name}"/>
              </HierarchicalDataTemplate>
              <DataTemplate DataType="{x:Type core:CodeSymbol}">
                <TextBlock Text="{Binding SimpleName}"/>
              </DataTemplate>
            </TreeView.Resources>
          </TreeView>
        </DockPanel>
      </Border>
      </Grid>
    </Grid>

    <DockPanel Visibility="{Binding IsGraph, Converter={StaticResource BoolVis}}">
      <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
        <DockPanel.DataContext>
          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
        </DockPanel.DataContext>
        <Button DockPanel.Dock="Right" Content="展开上一层" Padding="10,2" Margin="8,0,0,0"
                Click="Expand_Click" IsEnabled="{Binding CanExpandLayer}"/>
        <Button DockPanel.Dock="Right" Content="进入 Z 抽出" Padding="10,2"
                Click="EnterZ_Click" IsEnabled="{Binding CanEnterZ}">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveDocument.IsFileMenu}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      </DockPanel>
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" BorderBrush="#E4E7EC" BorderThickness="0,0,1,0"
                Visibility="{Binding IsFunctionLayer, Converter={StaticResource BoolVis}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="8,6" FontWeight="SemiBold" Text="这一层的函数"/>
            <ListBox ItemsSource="{Binding Cards}" BorderThickness="0" SelectionChanged="Layer_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type core:FunctionCard}">
                  <StackPanel Margin="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StepLabel}" Foreground="#667085" FontSize="11"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
          <local:FlowCanvas x:Name="GraphFlow"/>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>

    <ScrollViewer Visibility="{Binding IsSystemDna, Converter={StaticResource BoolVis}}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding DnaHeadline}"/>
        <TextBlock Margin="0,6,0,16" Foreground="#667085" TextWrapping="Wrap" Text="{Binding DnaPath}"/>
        <ItemsControl ItemsSource="{Binding DnaGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type core:DnaGroup}">
              <StackPanel Margin="0,0,0,18">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}"/>
                <TextBlock Foreground="#667085" Text="{Binding MachineName}"/>
                <TextBlock Margin="0,2,0,8" TextWrapping="Wrap" Text="{Binding Description}"/>
                <ItemsControl ItemsSource="{Binding Leaves}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:DnaLeaf}">
                      <Border Margin="0,0,0,8" Padding="10" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="6" Background="#F8FAFC">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="#667085" Text="{Binding DataType}"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                          </DockPanel>
                          <TextBlock Margin="0,2,0,0" Foreground="#344054">
                            <Run Text="{Binding MachineName, Mode=OneWay}"/>
                            <Run Text="    默认 "/>
                            <Run Text="{Binding DefaultValue, Mode=OneWay}"/>
                            <Run Text="    "/>
                            <Run Text="{Binding Range, Mode=OneWay}"/>
                          </TextBlock>
                          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#667085" Text="{Binding Description}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Visibility="{Binding IsClassScatter, Converter={StaticResource BoolVis}}">
      <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
        <Button DockPanel.Dock="Right" Content="打开这个簇" Padding="10,2" Click="Cluster_Click">
          <Button.DataContext>
            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
          </Button.DataContext>
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="IsEnabled" Value="{Binding CanOpenCluster}"/>
            </Style>
          </Button.Style>
        </Button>
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="类簇。点一张卡片再打开簇内的类。"/>
      </DockPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
        <local:FlowCanvas x:Name="ScatterFlow"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
