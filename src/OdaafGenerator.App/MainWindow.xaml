<Window x:Class="OdaafGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:OdaafGenerator.Core;assembly=OdaafGenerator.Core"
        xmlns:local="clr-namespace:OdaafGenerator.App"
        Title="OdaafGenerator"
        Height="860" Width="1360"
        MinHeight="680" MinWidth="1100"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        FontSize="13">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件">
        <MenuItem Header="打开工程索引…" Click="Browse_Click"/>
        <MenuItem Header="重新加载" Click="Load_Click"/>
        <Separator/>
        <MenuItem Header="退出" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="上下文">
        <MenuItem Header="文件菜单" Click="ShowFileNav_Click"/>
        <MenuItem Header="解析入库" Click="ShowIndex_Click"/>
        <MenuItem Header="ODAAF" Click="ShowOdaaf_Click"/>
      </MenuItem>
      <MenuItem Header="视图">
        <MenuItem Header="工程索引" Click="ViewProject_Click"/>
        <MenuItem Header="目录查找" Click="ViewBrowse_Click"/>
        <Separator/>
        <MenuItem Header="文件菜单图" Click="ViewMenu_Click"/>
        <MenuItem Header="Z 抽出" Click="ViewZ_Click"/>
        <MenuItem Header="类散图" Click="ViewScatter_Click"/>
        <MenuItem Header="函数层" Click="ViewLayer_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="#E8EEF5" BorderBrush="#D0D5DD" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Foreground="#667085" Text="{Binding ProjectFilePath}" TextTrimming="CharacterEllipsis"/>
        <TextBlock FontWeight="SemiBold" Text="{Binding ContextLine}"/>
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Margin="12,6" Foreground="#344054" Text="{Binding Status}"/>
    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="160"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="240"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="300" MinWidth="180"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
        <Grid>
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFileNavContext}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
              <TextBlock FontWeight="SemiBold" Text="文件菜单"/>
              <TextBlock Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" FontSize="12"
                         Text="分组 → 菜单 → 处理函数。展开看下一层调用。点节点，右边画这一层。"/>
            </StackPanel>
            <TreeView BorderThickness="0" ItemsSource="{Binding NavRoots}"
                      SelectedItemChanged="Nav_SelectedItemChanged">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="False"/>
                  <EventSetter Event="Expanded" Handler="Nav_Expanded"/>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type core:NavNode}" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="{Binding Title}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="FontWeight" Value="Normal"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding MainFlow}" Value="True">
                              <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="8,0,0,0" Foreground="#667085" Text="{Binding Hint}"/>
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.Resources>
            </TreeView>
          </DockPanel>
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFileNavContext}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4" FontWeight="SemiBold" Text="当前上下文的视图"/>
            <ListBox ItemsSource="{Binding ContextViews}" SelectedItem="{Binding SelectedView}" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type core:WorkspaceView}">
                  <TextBlock Margin="2,4" Text="{Binding Title}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    Background="#C5CDD6" Cursor="SizeWE" ShowsPreview="True"/>

      <Border Grid.Column="2" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
        <Grid>
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFileNavContext}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <TextBlock DockPanel.Dock="Top" Margin="12,8,12,4" FontWeight="SemiBold"
                       Text="这一层的流程图（不跨进被调函数）"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
              <local:FlowCanvas x:Name="NavFlow"/>
            </ScrollViewer>
          </DockPanel>
          <TabControl>
            <TabControl.Style>
              <Style TargetType="TabControl">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFileNavContext}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TabControl.Style>
            <TabControl.ItemsSource>
              <Binding Path="Documents"/>
            </TabControl.ItemsSource>
            <TabControl.SelectedItem>
              <Binding Path="ActiveDocument"/>
            </TabControl.SelectedItem>
            <TabControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WorkspaceDocument}">
                <TextBlock Text="{Binding Title}"/>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate DataType="{x:Type local:WorkspaceDocument}">
                <local:DocumentHost/>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    Background="#C5CDD6" Cursor="SizeWE" ShowsPreview="True"/>

      <Border Grid.Column="4" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="12,8,12,4" FontWeight="SemiBold" Text="函数枝图"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,4,12,12">
              <TextBlock TextWrapping="Wrap" Foreground="#667085"
                         Text="动因下面先是中文名，再是功能说明。物因下面是参数含义。结构因先空着。系统调用只有说明。"/>
              <StackPanel Margin="0,10,0,0" DataContext="{Binding SelectedCard}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="动因" Foreground="#1D4E89" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Name}" FontSize="18" Margin="0,2,0,2" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FriendlyName}" FontSize="15" Foreground="#1D4E89" Margin="0,0,0,4" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FriendlyName}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" Margin="0,0,0,8">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Purpose}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Documents}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#3F6212">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Documents}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SyntaxPath}" Foreground="#667085" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="物因" Foreground="#1D4E89" FontWeight="SemiBold"/>
                <TextBlock Text="（无参数）" Margin="0,4,0,4" Foreground="#667085">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Materials.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Materials}" Margin="0,4,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ParameterLeaf}">
                      <TextBlock Margin="0,1" TextWrapping="Wrap">
                        <Run Text="{Binding Type, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Name, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding Meaning, Mode=OneWay}" Foreground="#667085"/>
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WritesStructure}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="结构因" Foreground="#1D4E89" FontWeight="SemiBold"/>
                  <TextBox Text="{Binding Formal, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                           MinHeight="56" TextWrapping="Wrap" Margin="0,4,0,8" LostFocus="Cause_LostFocus"/>
                  <TextBlock Text="极因" Foreground="#1D4E89" FontWeight="SemiBold"/>
                  <TextBox Text="{Binding Final, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                           MinHeight="56" TextWrapping="Wrap" Margin="0,4,0,8" LostFocus="Cause_LostFocus"/>
                </StackPanel>
                <TextBlock Text="系统调用不写结构因。" Foreground="#667085" Margin="0,0,0,8">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WritesStructure}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#667085"/>
                <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="11" Foreground="#667085"/>
                <TextBlock Text="{Binding Signature}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
